{
  "schema_version": 1,
  "title": "The Chaotic Caves",
  "description": "\"Fell monsters inhabit a network of caves on the borderland between savage wilderness and frontier civilization. Can the heroic adventurers root them out and save nearby towns and villages from attack?\"",
  "hooks": [
    "Treasure recovery and monster exterminators needed.",
    "All goods recovered by lawful means from monsters become the property of the carrier.",
    "Recently, monsters have become more numerous and sudden, savage attacks have occurred against locals.",
    "Lizard men raid local shipping now and then, carrying off loot.",
    "Most of the monsters being encountered are orcs, goblins, gnolls, and other lower-level creatures.",
    "There is an old funeral crypt far off into the wilderness that the monsters are probably using as a base.",
    "Human bandits are causing problems for outlying farms.",
    "Some travelers have been attacked by Magic-User and Cleric spells.",
    "People have been killed and eaten by ghouls near the crypt area."
  ],
  "party": {
    "min_level": 1,
    "max_level": 3,
    "min_size": null,
    "max_size": null
  },
  "town": {
    "name": "",
    "description": "The town lies at the crossroads of a river and an old paved highway. It thrives on trade and commerce.",
    "services": [
      "weapons and body armor smithies",
      "merchants offering food, clothing, and basic goods",
      "a Cleric and healer",
      "horses and wagons",
      "freight service",
      "coach service",
      "courier service",
      "docks with a narrow wooden pier",
      "boats purchased or rented",
      "baker",
      "banker",
      "bed-and-breakfast",
      "school",
      "small library",
      "tavern of the Full Tankard",
      "tavern with rooms for rent",
      "merchant",
      "stables",
      "church",
      "freight service with wagons and storage",
      "lumber concern"
    ]
  },
